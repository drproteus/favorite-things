# Copy to .env in the repo root and fill in. The backend loads ./.env or ../.env automatically
# (or set the variables in your shell / docker compose environment).

# Where the API listens, and the URLs used for OAuth callbacks and post-login redirects.
ADDR=:8080
PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Postgres
DATABASE_URL=postgres://favs:favs@localhost:5433/favorites?sslmode=disable

# Sessions
SESSION_TTL=720h
# Set to true when served over HTTPS (required in production).
COOKIE_SECURE=false

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth: https://github.com/settings/developers
# Authorization callback URL: {PUBLIC_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
# Endpoint the browser uses for image URLs. Only needed when S3_ENDPOINT is an internal hostname.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=favorite-things
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# true for MinIO; false for AWS S3
S3_PATH_STYLE=true

# Photo suggestions: fills in an item's title, description and hashtags from its first photo.
# Off unless SUGGEST_ENABLED=true. SUGGEST_PROVIDER is gemini (default) or bedrock.
SUGGEST_ENABLED=false
SUGGEST_PROVIDER=gemini
SUGGEST_DAILY_LIMIT=50

# Gemini: create a key at https://aistudio.google.com/app/apikey (no card needed for the free tier).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Bedrock (only if SUGGEST_PROVIDER=bedrock). Locally, use AWS_PROFILE or AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# AWS_PROFILE=your-profile