DATABASE_URL=postgres://{{ favorite_things_db_user }}:{{ favorite_things_db_password | urlencode }}@{{ favorite_things_db_host }}:{{ favorite_things_db_port }}/{{ favorite_things_db_name }}?sslmode=disable
MINIO_URL={{ favorite_things_minio_url }}
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY={{ favorite_things_minio_root_password }}
MINIO_BUCKET={{ favorite_things_minio_bucket }}

{% if favorite_things_gemini_api_key | length > 0 %}
SUGGEST_ENABLED=true
GEMINI_API_KEY={{ favorite_things_gemini_api_key }}
{% endif %}

GITHUB_CLIENT_ID={{ favorite_things_github_client_id }}
GITHUB_CLIENT_SECRET={{ favorite_things_github_client_secret }}
GOOGLE_CLIENT_ID={{ favorite_things_google_client_id }}
GOOGLE_CLIENT_SECRET={{ favorite_things_google_client_secret }}

PUBLIC_URL={{ favorite_things_api_url }}
LISTEN_ADDR={{ favorite_things_listen_addr }}
